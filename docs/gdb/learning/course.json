          "title": "FileGDB 文件家族标准表",
          "summary": "同一个内部编号代表一个文件家族候选，扩展名表达不同物理职责。",
          "diagram": {
            "items": [
              {"name": ".gdbtable", "role": "字段描述和记录内容", "query": "读取 Schema 与业务值", "required": "核心"},
              {"name": ".gdbtablx", "role": "FID/记录位置到 offset 的映射", "query": "定位记录", "required": "常用"},
              {"name": ".spx", "role": "空间索引候选集合", "query": "缩小空间查询候选", "required": "可选/可回退"},
              {"name": ".atx", "role": "属性索引候选集合", "query": "加速属性条件", "required": "可选"},
