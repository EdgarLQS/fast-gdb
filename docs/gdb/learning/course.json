          "kind": "graph",
          "title": "能力边界标准图",
          "summary": "用三种能力层级检查 AI 或代码的结论强度。",
          "diagram": {
            "viewBox": "0 0 900 250",
            "nodes": [
              {"id": "physical", "label": "Physical Read\n能定位和读出字节", "layer": "physical", "x": 35, "y": 80, "w": 230, "h": 85},
              {"id": "schema", "label": "Structured Schema\n能解释字段、对象和关系", "layer": "behavior", "x": 335, "y": 80, "w": 230, "h": 85},
              {"id": "behavioral", "label": "Behavioral Parity\n能复现规则和行为", "layer": "logic", "x": 635, "y": 80, "w": 230, "h": 85}
            ],
            "edges": [{"from": "physical", "to": "schema", "label": "需要元数据证据"}, {"from": "schema", "to": "behavioral", "label": "需要行为验证"}]
