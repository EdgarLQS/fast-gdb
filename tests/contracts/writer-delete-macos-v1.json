{
  "schema_version": 2,
  "contract_id": "writer-delete-macos-v1",
  "title": "Writer staged Delete macOS contract",
  "platform": "macOS",
  "random_seed": 42,
  "allowed_results": ["PASS", "FAIL", "SKIP"],
  "allowed_skip_reasons": [
    "missing_gdal",
    "missing_dataset",
    "insufficient_disk",
    "manual_gate_disabled",
    "unsupported_platform"
  ],
  "scenarios": [
    {
      "id": "W-DELETE-001",
      "title": "Delete preserves remaining FIDs and shrinks extent",
      "kind": "gtest",
      "binary": "full",
      "filter": "WriterDeleteFixture.DeletesSelectedFidsAndPreservesRemainingFids",
      "gate": "required",
      "data_scale": "small-generated",
      "cache_state": "fresh-open",
      "assertions": ["row_count", "deleted_fids_absent", "remaining_fids", "extent", "gdal_reopen"]
    },
    {
      "id": "W-DELETE-002",
      "title": "Delete all records leaves a valid empty layer",
      "kind": "gtest",
      "binary": "full",
      "filter": "WriterDeleteFixture.DeletesAllRecordsWithoutReusingFids",
      "gate": "required",
      "data_scale": "small-generated",
      "cache_state": "fresh-open",
      "assertions": ["empty_layer", "deleted_fids_absent", "no_fid_reuse"]
    },
    {
      "id": "W-DELETE-003",
      "title": "Delete abort and destructor preserve source",
      "kind": "gtest",
      "binary": "full",
      "filter": "WriterDeleteFixture.AbortAndDestructorPreserveSource",
      "gate": "required",
      "data_scale": "small-generated",
      "cache_state": "fresh-open",
      "assertions": ["staging_cleanup", "source_unchanged"]
    },
    {
      "id": "W-DELETE-004",
      "title": "Delete rejects missing/repeated FIDs and source mutation",
      "kind": "gtest",
      "binary": "full",
      "filter": "WriterDeleteFixture.WriterDeleteValidationTest_*",
      "gate": "required",
      "data_scale": "small-generated",
      "cache_state": "fresh-open",
      "assertions": ["missing_fid", "duplicate_delete", "source_fingerprint", "no_publish"]
    },
    {
      "id": "W-DELETE-005",
      "title": "Delete preserves index-backed query correctness",
      "kind": "gtest",
      "binary": "full",
      "filter": "WriterDeleteFixture.WriterDeleteIndexTest_*",
      "gate": "required",
      "data_scale": "small-generated",
      "cache_state": "fresh-open",
      "assertions": ["attribute_index", "spatial_index", "no_stale_hits"]
    }
  ]
}
